<Window x:Class="IslasEscritorio.Islands.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid x:Name="RootGrid" Margin="10">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="AnimScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="AnimTranslate" X="0" Y="0"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <Border x:Name="SurfaceBorder"
                CornerRadius="12"
                BorderThickness="1"
                Padding="12,10">
            <Border.Effect>
                <DropShadowEffect x:Name="ShadowEffect"
                                  BlurRadius="18"
                                  ShadowDepth="3"
                                  Opacity="0.45"
                                  Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Encabezado de la isla -->
                <Grid Grid.Row="0" Margin="0,0,0,8" MouseLeftButtonDown="OnTitleMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="AccentPill"
                            Grid.Column="0"
                            Width="4"
                            Height="16"
                            CornerRadius="2"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"/>

                    <TextBlock x:Name="TitleText"
                               Grid.Column="1"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>

                    <Border x:Name="CountBadge"
                            Grid.Column="2"
                            CornerRadius="8"
                            Padding="7,2"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="CountText"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <!-- Contenido desplazable -->
                <ScrollViewer x:Name="ItemsScrollViewer" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel x:Name="ContentHost"/>
                </ScrollViewer>

                <!-- Host de Música -->
                <Grid x:Name="MusicHost" Grid.Row="1" Visibility="Collapsed" Margin="4,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" x:Name="MusicArtColumn"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Portada de la Canción -->
                    <Border x:Name="MusicArtContainer" Grid.Column="0" Width="100" Height="100" Margin="0,0,12,0" VerticalAlignment="Center" CornerRadius="12" ClipToBounds="True" Background="#232334">
                        <Grid>
                            <Image x:Name="MusicCoverImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Grid x:Name="MusicCoverPlaceholder" Background="#1E1E2E" Visibility="Visible">
                                <Border x:Name="VinylGrooveBorder" CornerRadius="50" BorderBrush="#1CFFFFFF" BorderThickness="12" Margin="8" Visibility="Collapsed"/>
                                <TextBlock x:Name="MusicPlaceholderIcon" Text="🎵" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
                            </Grid>
                            <Border x:Name="MusicArtOverlayBorder" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="12"/>
                        </Grid>
                    </Border>

                    <!-- Info y Controles -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <!-- Header row: App badge & Ecualizador -->
                        <DockPanel Margin="0,0,0,4">
                            <StackPanel x:Name="EqualizerHost" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Height="14" Margin="6,0,0,0">
                                <Rectangle x:Name="EqBar1" Width="3" Height="8" Fill="#89B4FA" Margin="1,0" RadiusX="1" RadiusY="1"/>
                                <Rectangle x:Name="EqBar2" Width="3" Height="12" Fill="#89B4FA" Margin="1,0" RadiusX="1" RadiusY="1"/>
                                <Rectangle x:Name="EqBar3" Width="3" Height="6" Fill="#89B4FA" Margin="1,0" RadiusX="1" RadiusY="1"/>
                                <Rectangle x:Name="EqBar4" Width="3" Height="10" Fill="#89B4FA" Margin="1,0" RadiusX="1" RadiusY="1"/>
                            </StackPanel>

                            <Border x:Name="MusicAppBadge" DockPanel.Dock="Left" Background="#2589B4FA" CornerRadius="6" Padding="7,2" HorizontalAlignment="Left">
                                <TextBlock x:Name="MusicAppText" Text="Multimedia" FontSize="11" FontWeight="Bold" Foreground="#89B4FA"/>
                            </Border>
                        </DockPanel>

                        <!-- Pista y Artista -->
                        <TextBlock x:Name="MusicTrackText" Text="No hay música activa" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                        <TextBlock x:Name="MusicArtistText" Text="Inicia reproducción en una app compatible" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

                        <!-- Botones de Control Estilizados y Barra de Volumen -->
                        <StackPanel x:Name="MusicControlsHost" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="MusicPrevButton" Content="⏮" Width="38" Height="34" Margin="0,0,6,0" Click="OnPreviousTrackClick" ToolTip="Anterior"/>
                            <Button x:Name="MusicPlayPauseButton" Content="▶" Width="52" Height="34" Margin="0,0,6,0" Click="OnPlayPauseClick" ToolTip="Reproducir / Pausar"/>
                            <Button x:Name="MusicNextButton" Content="⏭" Width="38" Height="34" Margin="0,0,6,0" Click="OnNextTrackClick" ToolTip="Siguiente"/>
                            <Border Width="1" Height="22" Background="#33FFFFFF" Margin="6,0,8,0" VerticalAlignment="Center"/>
                            <Button x:Name="MusicMuteButton" Content="🔊" Width="34" Height="34" Margin="0,0,6,0" Click="OnVolumeMuteClick" ToolTip="Silenciar / Activar sonido"/>
                            <Slider x:Name="MusicVolumeSlider" Width="95" Height="24" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="50" ValueChanged="OnMusicVolumeSliderValueChanged" ToolTip="Volumen del sistema"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Host de Reloj -->
                <Grid x:Name="ClockHost" Grid.Row="1" Visibility="Collapsed" Margin="8,4">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="ClockTimeText" Text="12:00:00" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Consolas"/>
                        <TextBlock x:Name="ClockDateText" Text="Lunes, 1 de Enero de 2025" FontSize="13" Opacity="0.8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Host de Monitor de Sistema -->
                <Grid x:Name="SystemHost" Grid.Row="1" Visibility="Collapsed" Margin="6,4">
                    <StackPanel VerticalAlignment="Center">
                        <!-- RAM -->
                        <Grid x:Name="RamRowGrid" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RAM" FontSize="12" FontWeight="SemiBold" Grid.Column="0"/>
                            <ProgressBar x:Name="RamProgressBar" Height="10" Value="45" Maximum="100" Grid.Column="1" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RamValueText" Text="45%" FontSize="11" TextAlignment="Right" Grid.Column="2"/>
                        </Grid>
                        <!-- DISCO -->
                        <Grid x:Name="DiskRowGrid" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Disco C:" FontSize="12" FontWeight="SemiBold" Grid.Column="0"/>
                            <ProgressBar x:Name="DiskProgressBar" Height="10" Value="60" Maximum="100" Grid.Column="1" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DiskValueText" Text="60%" FontSize="11" TextAlignment="Right" Grid.Column="2"/>
                        </Grid>
                        <!-- CPU -->
                        <Grid x:Name="CpuRowGrid" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CPU" FontSize="12" FontWeight="SemiBold" Grid.Column="0"/>
                            <ProgressBar x:Name="CpuProgressBar" Height="10" Value="15" Maximum="100" Grid.Column="1" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CpuValueText" Text="15%" FontSize="11" TextAlignment="Right" Grid.Column="2"/>
                        </Grid>

                        <!-- Botón de Optimizar RAM -->
                        <Button x:Name="CleanRamButton" Content="⚡ Optimizar RAM" Height="28" Margin="0,8,0,0" Click="OnCleanRamClick" ToolTip="Liberar memoria RAM inactiva de procesos" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- Host de Notas Rápidas -->
                <Grid x:Name="NotesHost" Grid.Row="1" Visibility="Collapsed" Margin="4">
                    <TextBox x:Name="NotesTextBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="#1AFFFFFF"
                             Foreground="{Binding ElementName=TitleText, Path=Foreground}"
                             BorderThickness="0"
                             Padding="8"
                             FontSize="12"
                             TextChanged="OnNotesTextChanged"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
