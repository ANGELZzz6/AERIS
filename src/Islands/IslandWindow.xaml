<Window x:Class="IslasEscritorio.Islands.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid x:Name="RootGrid" Margin="10">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="AnimScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="AnimTranslate" X="0" Y="0"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <Border x:Name="SurfaceBorder"
                CornerRadius="12"
                BorderThickness="1"
                Padding="12,10">
            <Border.Effect>
                <DropShadowEffect x:Name="ShadowEffect"
                                  BlurRadius="18"
                                  ShadowDepth="3"
                                  Opacity="0.45"
                                  Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Encabezado de la isla -->
                <Grid Grid.Row="0" Margin="0,0,0,8" MouseLeftButtonDown="OnTitleMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="AccentPill"
                            Grid.Column="0"
                            Width="4"
                            Height="16"
                            CornerRadius="2"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"/>

                    <TextBlock x:Name="TitleText"
                               Grid.Column="1"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>

                    <Border x:Name="CountBadge"
                            Grid.Column="2"
                            CornerRadius="8"
                            Padding="7,2"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="CountText"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <!-- Contenido desplazable -->
                <ScrollViewer x:Name="ItemsScrollViewer" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel x:Name="ContentHost"/>
                </ScrollViewer>
                <StackPanel x:Name="MusicHost" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8">
                    <TextBlock x:Name="MusicTrackText" Text="No hay música activa" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock x:Name="MusicArtistText" Text="Inicia la reproducción en una app compatible" Opacity="0.72" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="|◀" Padding="12,6" Margin="3" Click="OnPreviousTrackClick"/>
                        <Button x:Name="MusicPlayPauseButton" Content="▶ / ⏸" Padding="12,6" Margin="3" Click="OnPlayPauseClick"/>
                        <Button Content="▶|" Padding="12,6" Margin="3" Click="OnNextTrackClick"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
