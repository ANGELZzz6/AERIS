<Window x:Class="IslasEscritorio.Islands.OcrOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AERIS - Extracción de Texto OCR"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#50000000"
        Topmost="True"
        WindowState="Maximized"
        ShowInTaskbar="False"
        Cursor="Cross"
        KeyDown="OnKeyDown"
        MouseDown="OnMouseDown"
        MouseMove="OnMouseMove"
        MouseUp="OnMouseUp">
    <Grid>
        <Canvas x:Name="SelectionCanvas">
            <!-- Rectángulo de selección estilo recortador -->
            <Rectangle x:Name="SelectionRectangle"
                       Fill="#2589B4FA"
                       Stroke="#89B4FA"
                       StrokeThickness="2"
                       StrokeDashArray="4 2"
                       Visibility="Collapsed"/>
        </Canvas>

        <!-- Banner instruccional flotante -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                Background="#1E1E2ECC" CornerRadius="12" Padding="16,10"
                BorderBrush="#45475A" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔍 " FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="Arrastra para seleccionar el área con texto  •  Presiona ESC para cancelar"
                           Foreground="#CDD6F4" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
