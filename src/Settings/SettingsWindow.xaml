<Window x:Class="IslasEscritorio.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AERIS · Ajustes"
        Width="980"
        Height="680"
        MinWidth="840"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#161622"
        Foreground="#ECEFF8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECEFF8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#ECEFF8"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#232336"/>
            <Setter Property="Foreground" Value="#ECEFF8"/>
            <Setter Property="BorderBrush" Value="#3E3E5E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CaretBrush" Value="#89B4FA"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#232336"/>
            <Setter Property="Foreground" Value="#161622"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A40"/>
            <Setter Property="Foreground" Value="#ECEFF8"/>
            <Setter Property="BorderBrush" Value="#3E3E5E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#BAC2DE"/>
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de aviso de errores JSON -->
        <Border x:Name="ErrorBanner"
                Grid.Row="0"
                Visibility="Collapsed"
                Background="#4A1F28"
                BorderBrush="#F38BA8"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,8"
                Margin="0,0,0,10">
            <TextBlock x:Name="ErrorBannerText" TextWrapping="Wrap" Foreground="#FFD6E0"/>
        </Border>

        <TabControl Grid.Row="1" Background="#1E1E2E" BorderBrush="#313244">
            <!-- 1. GENERAL -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="Comportamiento general" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <CheckBox x:Name="HideDesktopIconsCheck"
                                  Content="Ocultar iconos nativos del escritorio mientras la app está activa"/>
                        <CheckBox x:Name="StartWithWindowsCheck"
                                  Content="Iniciar automáticamente con Windows"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
                            <TextBlock Text="Idioma:" Width="160"/>
                            <ComboBox x:Name="LanguageCombo" Width="180">
                                <ComboBoxItem Content="es" Tag="es"/>
                                <ComboBoxItem Content="en" Tag="en"/>
                            </ComboBox>
                        </StackPanel>

                        <Separator Margin="0,16" Background="#313244"/>

                        <TextBlock Text="Configuración y recuperación" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock x:Name="ConfigPathText" Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <WrapPanel>
                            <Button Content="Importar JSON..." Click="OnImportJsonClick" Margin="0,0,8,8"/>
                            <Button Content="Exportar JSON..." Click="OnExportJsonClick" Margin="0,0,8,8"/>
                            <Button Content="Abrir config.json" Click="OnOpenJsonClick" Margin="0,0,8,8"/>
                            <Button Content="Restaurar valores por defecto" Click="OnResetDefaultsClick" Margin="0,0,8,8"/>
                            <Button Content="Restaurar iconos del escritorio ahora" Click="OnRestoreIconsNowClick"
                                    Background="#362A24" BorderBrush="#FAB387" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. ISLAS + VISTA PREVIA -->
            <TabItem Header="Islas">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="270"/>
                    </Grid.ColumnDefinitions>

                    <!-- Lista de islas -->
                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock DockPanel.Dock="Top" Text="Islas configuradas" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,8,0,0">
                            <Button Content="Añadir" Click="OnAddIslandClick" Margin="0,0,4,4"/>
                            <Button Content="Duplicar" Click="OnDuplicateIslandClick" Margin="4,0,0,4"/>
                            <Button Content="Subir" Click="OnMoveIslandUpClick" Margin="0,4,4,0"/>
                            <Button Content="Bajar" Click="OnMoveIslandDownClick" Margin="4,4,0,0"/>
                        </UniformGrid>
                        <Button DockPanel.Dock="Bottom" Content="Eliminar isla" Click="OnRemoveIslandClick"
                                Margin="0,6,0,0" Background="#3B2028" BorderBrush="#F38BA8"/>
                        <ListBox x:Name="IslandsListBox"
                                 Background="#181825"
                                 Foreground="#ECEFF8"
                                 BorderBrush="#313244"
                                 SelectionChanged="OnSelectedIslandChanged"/>
                    </DockPanel>

                    <!-- Editor de isla -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="8,0,12,0">
                        <StackPanel x:Name="IslandEditorPanel">
                            <TextBlock Text="Propiedades de la isla" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <CheckBox x:Name="IslandEnabledCheck" Content="Isla habilitada"
                                      Checked="OnIslandFieldChanged" Unchecked="OnIslandFieldChanged"/>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="135"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Función:"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="IslandTypeCombo" Margin="0,3" SelectionChanged="OnIslandFieldChanged">
                                    <ComboBoxItem Content="Archivos y carpetas" Tag="archivos"/>
                                    <ComboBoxItem Content="Música y reproductor" Tag="musica"/>
                                    <ComboBoxItem Content="Reloj y fecha" Tag="reloj"/>
                                    <ComboBoxItem Content="Monitor de sistema" Tag="sistema"/>
                                    <ComboBoxItem Content="Notas rápidas" Tag="notas"/>
                                </ComboBox>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Nombre:"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="IslandNameBox" Margin="0,3" TextChanged="OnIslandFieldChanged"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="ID:"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="IslandIdBox" Margin="0,3" TextChanged="OnIslandFieldChanged"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Borde / esquina:"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="IslandEdgeCombo" Margin="0,3" SelectionChanged="OnIslandFieldChanged"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Ancla:"/>
                                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="IslandAnchorCombo" Margin="0,3" SelectionChanged="OnIslandFieldChanged"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Monitor:"/>
                                <TextBox Grid.Row="5" Grid.Column="1" x:Name="IslandMonitorBox" Margin="0,3"
                                         ToolTip="principal, todos, o índice (0, 1...)" TextChanged="OnIslandFieldChanged"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Ancho (px / %):"/>
                                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                    <TextBox x:Name="IslandWidthPxBox" Width="80" Margin="0,0,8,0" ToolTip="Ancho en px (opcional)" TextChanged="OnIslandFieldChanged"/>
                                    <TextBox x:Name="IslandWidthPctBox" Width="80" ToolTip="Ancho en % (opcional)" TextChanged="OnIslandFieldChanged"/>
                                </StackPanel>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Alto (px / %):"/>
                                <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                    <TextBox x:Name="IslandHeightPxBox" Width="80" Margin="0,0,8,0" ToolTip="Alto en px (opcional)" TextChanged="OnIslandFieldChanged"/>
                                    <TextBox x:Name="IslandHeightPctBox" Width="80" ToolTip="Alto en % (opcional)" TextChanged="OnIslandFieldChanged"/>
                                </StackPanel>

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Desplazamiento X/Y:"/>
                                <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                    <TextBox x:Name="IslandOffsetXBox" Width="80" Margin="0,0,8,0" TextChanged="OnIslandFieldChanged"/>
                                    <TextBox x:Name="IslandOffsetYBox" Width="80" TextChanged="OnIslandFieldChanged"/>
                                </StackPanel>

                                <TextBlock Grid.Row="9" Grid.Column="0" Text="Color acento (#hex):"/>
                                <TextBox Grid.Row="9" Grid.Column="1" x:Name="IslandAccentBox" Margin="0,3" TextChanged="OnIslandFieldChanged"/>

                                <TextBlock Grid.Row="10" Grid.Column="0" Text="Disposición:"/>
                                <ComboBox Grid.Row="10" Grid.Column="1" x:Name="IslandLayoutCombo" Margin="0,3" SelectionChanged="OnIslandFieldChanged"/>

                                <TextBlock Grid.Row="11" Grid.Column="0" Text="Orden y agrupación:"/>
                                <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                    <ComboBox x:Name="IslandSortCombo" Width="135" Margin="0,0,8,0" SelectionChanged="OnIslandFieldChanged"/>
                                    <ComboBox x:Name="IslandGroupCombo" Width="115" SelectionChanged="OnIslandFieldChanged"/>
                                </StackPanel>

                                <TextBlock Grid.Row="12" Grid.Column="0" Text="Incluir (patrones):"/>
                                <TextBox Grid.Row="12" Grid.Column="1" x:Name="IslandIncludeBox" Margin="0,3"
                                         ToolTip="Separados por coma, ej.: *.docx, *.pdf, *.lnk" TextChanged="OnIslandFieldChanged"/>

                                <TextBlock Grid.Row="13" Grid.Column="0" Text="Excluir (patrones):"/>
                                <TextBox Grid.Row="13" Grid.Column="1" x:Name="IslandExcludeBox" Margin="0,3"
                                         ToolTip="Separados por coma, ej.: desktop.ini, *.tmp" TextChanged="OnIslandFieldChanged"/>
                            </Grid>

                            <TextBlock Text="Fuentes y tipos incluidos:" Margin="0,8,0,4" FontWeight="SemiBold"/>
                            <WrapPanel>
                                <CheckBox x:Name="SourceUserCheck" Content="Escritorio usuario" Margin="0,2,12,2"
                                          Checked="OnIslandFieldChanged" Unchecked="OnIslandFieldChanged"/>
                                <CheckBox x:Name="SourcePublicCheck" Content="Escritorio público" Margin="0,2,12,2"
                                          Checked="OnIslandFieldChanged" Unchecked="OnIslandFieldChanged"/>
                            </WrapPanel>
                            <WrapPanel>
                                <CheckBox x:Name="TypeFileCheck" Content="Archivos" Margin="0,2,12,2"
                                          Checked="OnIslandFieldChanged" Unchecked="OnIslandFieldChanged"/>
                                <CheckBox x:Name="TypeFolderCheck" Content="Carpetas" Margin="0,2,12,2"
                                          Checked="OnIslandFieldChanged" Unchecked="OnIslandFieldChanged"/>
                                <CheckBox x:Name="TypeShortcutCheck" Content="Accesos directos" Margin="0,2,12,2"
                                          Checked="OnIslandFieldChanged" Unchecked="OnIslandFieldChanged"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Vista previa en tiempo real -->
                    <Border Grid.Column="2" Background="#11111B" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Vista previa en tiempo real" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Border x:Name="PreviewSurface"
                                    CornerRadius="12"
                                    BorderThickness="1"
                                    BorderBrush="#44FFFFFF"
                                    Padding="10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border x:Name="PreviewAccentPill" Width="4" Height="14" CornerRadius="2" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="PreviewTitleText" FontWeight="SemiBold" FontSize="13"/>
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="PreviewContentHost"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Música y especiales">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                        <TextBlock Text="Personalización de Islas Especiales" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="Configura el reproductor de música, la portada de la canción, los botones de control y otras islas inteligentes (reloj, sistema y notas)." TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,14"/>

                        <!-- Crear rápido islas especiales -->
                        <TextBlock Text="Crear nueva isla especial:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,16">
                            <Button Content="+ Música" Click="OnAddMusicIslandClick" Margin="0,0,8,6" Background="#243447" BorderBrush="#89DCEB"/>
                            <Button Content="+ Reloj" Click="OnAddClockIslandClick" Margin="0,0,8,6" Background="#3B3424" BorderBrush="#F9E2AF"/>
                            <Button Content="+ Monitor Sistema" Click="OnAddSystemIslandClick" Margin="0,0,8,6" Background="#3F242D" BorderBrush="#F38BA8"/>
                            <Button Content="+ Notas Rápidas" Click="OnAddNotesIslandClick" Margin="0,0,8,6" Background="#223B2A" BorderBrush="#A6E3A1"/>
                        </WrapPanel>

                        <Separator Background="#313244" Margin="0,0,0,14"/>

                        <TextBlock Text="Seleccionar isla a configurar:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="SpecialIslandCombo" Width="360" HorizontalAlignment="Left" DisplayMemberPath="Nombre" SelectionChanged="OnSpecialIslandChanged" Margin="0,0,0,14"/>

                        <TextBlock Text="Comportamiento y Despliegue:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Modo de despliegue:"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="SpecialModeCombo" Width="260" HorizontalAlignment="Left" SelectedValuePath="Tag" Margin="0,3">
                                <ComboBoxItem Content="Activar desde el borde" Tag="borde"/>
                                <ComboBoxItem Content="Siempre visible" Tag="siempre"/>
                                <ComboBoxItem Content="Flotante y arrastrable" Tag="flotante"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Posición flotante (X / Y):"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                <TextBox x:Name="SpecialXBox" Width="90" ToolTip="X en px" Margin="0,0,8,0"/>
                                <TextBox x:Name="SpecialYBox" Width="90" ToolTip="Y en px"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Color de fondo (#hex):"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="SpecialBgBox" Width="190" HorizontalAlignment="Left" Margin="0,3"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Opacidad (0.1 - 1.0):"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="SpecialOpacityBox" Width="110" HorizontalAlignment="Left" Margin="0,3"/>
                        </Grid>

                        <!-- Opciones específicas de Música -->
                        <Border x:Name="MusicOptionsGroup" Background="#161625" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Ajustes y Personalización del Reproductor de Música" FontWeight="SemiBold" Foreground="#89DCEB" Margin="0,0,0,10"/>

                                <CheckBox x:Name="SpecialShowCoverCheck" Content="Mostrar la portada de la canción (Album Art)" Checked="OnSpecialFieldChanged" Unchecked="OnSpecialFieldChanged"/>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Estilo de la portada:"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="SpecialCoverStyleCombo" Width="220" HorizontalAlignment="Left" Margin="0,3" SelectionChanged="OnSpecialFieldChanged">
                                        <ComboBoxItem Content="Esquinas redondeadas" Tag="redondeada"/>
                                        <ComboBoxItem Content="Cuadrada" Tag="cuadrada"/>
                                        <ComboBoxItem Content="Circular" Tag="circular"/>
                                        <ComboBoxItem Content="Disco de vinilo" Tag="vinilo"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Estilo de botones:"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="SpecialButtonsStyleCombo" Width="220" HorizontalAlignment="Left" Margin="0,3" SelectionChanged="OnSpecialFieldChanged">
                                        <ComboBoxItem Content="Moderno (Cápsulas)" Tag="moderno"/>
                                        <ComboBoxItem Content="Pastilla (Borde acento)" Tag="pastilla"/>
                                        <ComboBoxItem Content="Minimalista" Tag="minimalista"/>
                                    </ComboBox>
                                </Grid>

                                <CheckBox x:Name="SpecialShowAppCheck" Content="Mostrar la app de origen (ej. Spotify, Edge, Chrome)" Checked="OnSpecialFieldChanged" Unchecked="OnSpecialFieldChanged" Margin="0,8,0,0"/>
                                <CheckBox x:Name="SpecialShowEqCheck" Content="Mostrar ecualizador gráfico animado al reproducir" Checked="OnSpecialFieldChanged" Unchecked="OnSpecialFieldChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Opciones específicas de Reloj -->
                        <Border x:Name="ClockOptionsGroup" Background="#161625" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Ajustes de la Isla Reloj y Fecha" FontWeight="SemiBold" Foreground="#F9E2AF" Margin="0,0,0,10"/>
                                <CheckBox x:Name="SpecialClock24Check" Content="Formato de hora de 24 horas (ej. 14:30 en vez de 02:30 PM)" Checked="OnSpecialFieldChanged" Unchecked="OnSpecialFieldChanged"/>
                                <CheckBox x:Name="SpecialClockSecondsCheck" Content="Mostrar segundos en el reloj" Checked="OnSpecialFieldChanged" Unchecked="OnSpecialFieldChanged"/>
                                <CheckBox x:Name="SpecialClockDateCheck" Content="Mostrar fecha completa (ej. Lunes, 24 de Mayo)" Checked="OnSpecialFieldChanged" Unchecked="OnSpecialFieldChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Opciones específicas de Monitor de Sistema -->
                        <Border x:Name="SystemOptionsGroup" Background="#161625" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Ajustes de Monitor de Sistema" FontWeight="SemiBold" Foreground="#F38BA8" Margin="0,0,0,10"/>
                                <CheckBox x:Name="SpecialSysRamCheck" Content="Mostrar monitor de memoria RAM" Checked="OnSpecialFieldChanged" Unchecked="OnSpecialFieldChanged"/>
                                <CheckBox x:Name="SpecialSysDiskCheck" Content="Mostrar monitor de almacenamiento (Disco C:)" Checked="OnSpecialFieldChanged" Unchecked="OnSpecialFieldChanged"/>
                                <CheckBox x:Name="SpecialSysCpuCheck" Content="Mostrar monitor de uso de CPU" Checked="OnSpecialFieldChanged" Unchecked="OnSpecialFieldChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Opciones específicas de Notas Rápidas -->
                        <Border x:Name="NotesOptionsGroup" Background="#161625" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Ajustes de Notas Rápidas" FontWeight="SemiBold" Foreground="#A6E3A1" Margin="0,0,0,10"/>
                                <TextBlock Text="Contenido de la nota guardada:" Margin="0,0,0,4"/>
                                <TextBox x:Name="SpecialNotesText" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="OnSpecialFieldChanged"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Tip: En modo flotante puedes arrastrar la isla manteniendo pulsado el clic sobre su encabezado." TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Barra de tareas">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="Personaliza la barra de tareas de Windows" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Personaliza el aspecto de la barra de tareas de Windows mediante los mismos mecanismos nativos de Win32 (SetWindowCompositionAttribute / DWM) que utiliza TranslucentTB. Soporta transparencia, acrílico, desenfoque y color personalizado." TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,14"/>
                        <CheckBox x:Name="TaskbarEnabledCheck" Content="Aplicar personalización de la barra de tareas"/>
                        <TextBlock Text="Fondo:" Margin="0,8,0,3"/>
                        <ComboBox x:Name="TaskbarStyleCombo" Width="260" HorizontalAlignment="Left" SelectedValuePath="Tag" Margin="0,0,0,10">
                            <ComboBoxItem Content="Normal / Predeterminado" Tag="normal"/>
                            <ComboBoxItem Content="Claro (Clear / 100% transparente)" Tag="clear"/>
                            <ComboBoxItem Content="Desenfoque (Blur)" Tag="blur"/>
                            <ComboBoxItem Content="Acrílico (Acrylic)" Tag="acrylic"/>
                            <ComboBoxItem Content="Opaco / Color (Opaque)" Tag="opaque"/>
                        </ComboBox>
                        <TextBlock Text="Color (#RRGGBB):"/>
                        <TextBox x:Name="TaskbarColorBox" Width="150" HorizontalAlignment="Left" Margin="0,4,0,10" ToolTip="Ejemplo: #202020"/>
                        <TextBlock Text="Alineación de iconos:"/>
                        <ComboBox x:Name="TaskbarAlignmentCombo" Width="260" HorizontalAlignment="Left" SelectedValuePath="Tag" Margin="0,4,0,10">
                            <ComboBoxItem Content="Centrados" Tag="centro"/>
                            <ComboBoxItem Content="A la izquierda" Tag="izquierda"/>
                        </ComboBox>
                        <CheckBox x:Name="TaskbarLabelsCheck" Content="Ocultar etiquetas de botones (Windows 11)" Margin="0,0,0,6"/>
                        <CheckBox x:Name="TaskbarBorderCheck" Content="Mostrar línea / borde superior de la barra (Show Line)" Margin="0,0,0,10"/>
                        <TextBlock Text="Combinar botones y ocultar etiquetas:" Margin="0,8,0,3"/>
                        <ComboBox x:Name="TaskbarCombineCombo" Width="300" HorizontalAlignment="Left" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Siempre" Tag="siempre"/>
                            <ComboBoxItem Content="Cuando la barra esté llena" Tag="lleno"/>
                            <ComboBoxItem Content="Nunca" Tag="nunca"/>
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 3. APARIENCIA -->
            <TabItem Header="Apariencia">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*" MinWidth="240"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tema:"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ThemeCombo" Margin="0,5" SelectionChanged="OnAppearanceChanged"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Color de fondo (#hex):"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="BgColorBox" Margin="0,5" TextChanged="OnAppearanceChanged"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Opacidad:"/>
                        <Slider Grid.Row="2" Grid.Column="1" x:Name="OpacitySlider" Minimum="0.2" Maximum="1.0" TickFrequency="0.05" Margin="0,8" ValueChanged="OnAppearanceChanged"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="OpacityValueText" Margin="10,0"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Desenfoque (Blur/Acrílico):"/>
                        <CheckBox Grid.Row="3" Grid.Column="1" x:Name="BlurCheck" Content="Activar desenfoque de fondo" Checked="OnAppearanceChanged" Unchecked="OnAppearanceChanged"/>

                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Estilo de isla:"/>
                        <CheckBox Grid.Row="11" Grid.Column="1" x:Name="GlassCheck" Content="Vidrio gloss (más transparente + blur)" Checked="OnAppearanceChanged" Unchecked="OnAppearanceChanged"/>
                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Color de nombres (#hex):"/>
                        <TextBox Grid.Row="12" Grid.Column="1" x:Name="TextColorBox" Margin="0,5" TextChanged="OnAppearanceChanged"/>
                        <TextBlock Grid.Row="13" Grid.Column="0" Text="Barra de desplazamiento:"/>
                        <ComboBox Grid.Row="13" Grid.Column="1" x:Name="ScrollbarStyleCombo" Margin="0,5" SelectedValuePath="Tag" SelectionChanged="OnAppearanceChanged">
                            <ComboBoxItem Content="Línea fina" Tag="linea"/>
                            <ComboBoxItem Content="Normal" Tag="normal"/>
                            <ComboBoxItem Content="Oculta" Tag="oculta"/>
                        </ComboBox>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Radio de esquinas (px):"/>
                        <Slider Grid.Row="4" Grid.Column="1" x:Name="CornerRadiusSlider" Minimum="0" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8" ValueChanged="OnAppearanceChanged"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" x:Name="CornerValueText" Margin="10,0"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Sombra:"/>
                        <CheckBox Grid.Row="5" Grid.Column="1" x:Name="ShadowCheck" Content="Mostrar sombra en islas" Checked="OnAppearanceChanged" Unchecked="OnAppearanceChanged"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Fuente:"/>
                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="FontBox" Margin="0,5" TextChanged="OnAppearanceChanged"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Tamaño de icono (px):"/>
                        <Slider Grid.Row="7" Grid.Column="1" x:Name="IconSizeSlider" Minimum="24" Maximum="96" TickFrequency="4" IsSnapToTickEnabled="True" Margin="0,8" ValueChanged="OnAppearanceChanged"/>
                        <TextBlock Grid.Row="7" Grid.Column="2" x:Name="IconSizeValueText" Margin="10,0"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Tipo de animación:"/>
                        <ComboBox Grid.Row="8" Grid.Column="1" x:Name="AnimTypeCombo" Margin="0,5"/>

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Duración animación (ms):"/>
                        <TextBox Grid.Row="9" Grid.Column="1" x:Name="AnimDurationBox" Margin="0,5"/>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Curva (easing):"/>
                        <ComboBox Grid.Row="10" Grid.Column="1" x:Name="AnimEasingCombo" Margin="0,5"/>
                        <Border Grid.Column="3" Grid.Row="0" Grid.RowSpan="13" Margin="0,8,0,0" Padding="16" Background="#11111B" BorderBrush="#313244" BorderThickness="1" CornerRadius="10" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Vista previa de la isla" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <Border x:Name="AppearancePreviewSurface" Background="#1E1E2E" BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12" MinHeight="180">
                                    <StackPanel>
                                        <TextBlock x:Name="AppearancePreviewTitle" Text="Mi isla" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="AppearancePreviewItem1" Text="📁 Proyectos" Margin="0,3"/>
                                        <TextBlock x:Name="AppearancePreviewItem2" Text="📄 Documento.pdf" Margin="0,3"/>
                                        <TextBlock x:Name="AppearancePreviewItem3" Text="📊 Presupuesto.xlsx" Margin="0,3"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="La muestra cambia al editar el fondo, la opacidad o el color del texto." TextWrapping="Wrap" Opacity="0.7" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 4. ACTIVACIÓN -->
            <TabItem Header="Activación">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Retardo de apertura (ms):"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="OpenDelayBox" Margin="0,5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Retardo de cierre (ms):"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="CloseDelayBox" Margin="0,5"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Grosor de zona (px):"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ZoneThicknessBox" Margin="0,5"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Monitores por defecto:"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="DefaultMonitorsCombo" Margin="0,5"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Comportamiento en esquinas:"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="CornerBehaviorCombo" Margin="0,5"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Ventana maximizada (ej. navegador):"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" x:Name="MaximizedBehaviorCombo" SelectedValuePath="Tag" Margin="0,5">
                                <ComboBoxItem Content="Desactivar islas laterales" Tag="desactivar"/>
                                <ComboBoxItem Content="Añadir retardo extra" Tag="retardo"/>
                                <ComboBoxItem Content="Comportamiento normal" Tag="normal"/>
                            </ComboBox>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Retardo extra maximizada (ms):"/>
                            <TextBox Grid.Row="6" Grid.Column="1" x:Name="MaximizedDelayBox" Margin="0,5"/>
                        </Grid>

                        <CheckBox x:Name="DisableFullscreenCheck" Content="Desactivar zonas cuando haya una aplicación en pantalla completa" Margin="0,12,0,4"/>
                        <CheckBox x:Name="DisableDraggingCheck" Content="Desactivar activación mientras se arrastra con el ratón"/>
                        <CheckBox x:Name="AlwaysOnTopCheck" Content="Mantener las islas siempre encima de otras ventanas"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 5. ATAJOS -->
            <TabItem Header="Asignaciones">
                <Grid Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Arrastra elementos entre las listas para asignarlos a una isla." FontSize="16" FontWeight="SemiBold"/>
                        <ComboBox x:Name="AssignmentIslandCombo" Width="280" HorizontalAlignment="Left" Margin="0,10,0,0" SelectionChanged="OnAssignmentIslandChanged"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Elementos del escritorio" Margin="0,0,0,6"/>
                            <ListBox Grid.Row="1" x:Name="AvailableItemsList" DisplayMemberPath="DisplayName" AllowDrop="True" PreviewMouseMove="OnAssignmentListMouseMove" Drop="OnAvailableItemsDrop" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="AssignedListTitle" Text="Elementos asignados" Margin="0,0,0,6"/>
                            <ListBox Grid.Row="1" x:Name="AssignedItemsList" DisplayMemberPath="DisplayName" AllowDrop="True" PreviewMouseMove="OnAssignmentListMouseMove" Drop="OnAssignedItemsDrop" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>



            <!-- 5. ATAJOS -->
            <TabItem Header="Atajos">
                <StackPanel Margin="18" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="Atajos globales del sistema" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="Usa combinaciones como Ctrl+Alt+Shift+D o haz clic en un campo y pulsa la combinación deseada."
                               Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="240"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Restaurar escritorio (emergencia):"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="ShortcutRestoreBox" Margin="0,6" PreviewKeyDown="OnShortcutKeyDown"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Pausar / reanudar:"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="ShortcutPauseBox" Margin="0,6" PreviewKeyDown="OnShortcutKeyDown"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Alternar islas visibles:"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="ShortcutToggleBox" Margin="0,6" PreviewKeyDown="OnShortcutKeyDown"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Abrir ajustes:"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="ShortcutSettingsBox" Margin="0,6" PreviewKeyDown="OnShortcutKeyDown"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Extraer texto OCR:"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="ShortcutOcrBox" Margin="0,6" PreviewKeyDown="OnShortcutKeyDown"/>
                    </Grid>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Barra inferior -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Opacity="0.8"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="🔍 Capturar Texto (OCR)" Click="OnRunOcrClick" Margin="0,0,16,0" Background="#2C3B4E" BorderBrush="#89B4FA"/>
                <Button Content="Aplicar" Click="OnApplyClick" Margin="0,0,8,0"/>
                <Button Content="Guardar y cerrar" Click="OnSaveAndCloseClick"
                        Background="#365486" BorderBrush="#89B4FA" Margin="0,0,8,0"/>
                <Button Content="Cancelar" Click="OnCancelClick"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>


